# Production build env — tracked so every Vercel deployment carries the
# sync device secret automatically (no dashboard setup needed).
#
# This value is deliberately public: it ships inside the JS bundle and gates
# the /api/sync + /api/accounts endpoints as a "gate, not a password"
# (see deploy/SUPABASE.md). Real security comes from Supabase RLS + the
# service-role grants. It must match SYNC_DEVICE_SECRET / VITE_SYNC_DEVICE_SECRET
# on the VPS (/etc/portmetals.env).
VITE_SYNC_DEVICE_SECRET=6546e81c5c8d04481cdc338aa2746d696bab2db7beee14f22dd2923c19339cd9