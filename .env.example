# ─── AI PROVIDERS ────────────────────────────────────────────────────────────
# Priority order: Hugging Face (primary, production AI) → Ollama (self-hosted
# Qwen3 on your VPS) → Google Gemini → local simulation. Set HUGGINGFACE_API_KEY
# for the real AI; the rest are optional fallbacks.

# HUGGINGFACE_API_KEY (alias: HF_TOKEN): Hugging Face Access Token with
# Inference enabled — the primary AI brain for chat, quote analysis and Zahara
# (finance). Get one from https://huggingface.co/settings/tokens
# The server calls Hugging Face Inference Providers (OpenAI-compatible router)
# and keeps the key server-side — never shipped to the browser.
HUGGINGFACE_API_KEY="hf_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"

# HUGGINGFACE_MODEL: model served on HF Inference Providers. Llama-3.3-70B is
# a strong default; switch to any model the router hosts (e.g.
# "Qwen/Qwen3-8B", "mistralai/Mistral-Small-24B-Instruct-2501").
# HUGGINGFACE_MODEL="meta-llama/Llama-3.3-70B-Instruct"

# OLLAMA_ENABLED: set to "true" to use the self-hosted Qwen3-4B running in
# Ollama on your VPS as a fast/offline fallback when Hugging Face is unreachable.
# OLLAMA_ENABLED="true"

# OLLAMA_BASE_URL: Ollama's OpenAI-compatible endpoint.
# - Same machine:      "http://localhost:11434/v1"
# - Remote VPS:        "http://YOUR_VPS_IP:11434/v1"  (expose Ollama via SSH
#   tunnel or a reverse proxy — do NOT leave the port open to the internet)
# - Docker compose:    "http://ollama:11434/v1"
# OLLAMA_BASE_URL="http://localhost:11434/v1"

# OLLAMA_MODEL: the model tag pulled into Ollama on the VPS.
# OLLAMA_MODEL="qwen3:4b"

# OLLAMA_API_KEY: Ollama ignores this, but an OpenAI-compatible client requires
# the field. Keep the default.
# OLLAMA_API_KEY="ollama"

# GEMINI_API_KEY: Required for the copilot VOICE (Gemini TTS — free Google AI
# Studio tier, uses Gemini's own neural voices) and used as the fallback live
# chat provider when Ollama is down or disabled. Get a free key from
# https://aistudio.google.com/apikey
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_TTS_MODEL / GEMINI_TTS_VOICE: the free Gemini TTS voice for the
# copilot. "Kore" is the female, firm, calm voice closest to Gemini's
# assistant. Other free female voices: Zephyr, Callirrhoe, Leda, Aoede,
# Erinome, Gacrux, Laomedeia, Vindemiatrix, Pulcherrima, Sulafat.
# GEMINI_TTS_MODEL="gemini-2.5-flash-preview-tts"
# GEMINI_TTS_VOICE="Kore"

# ─── DATABASE (Supabase / PostgreSQL) ────────────────────────────────────────
# The app persists its data to a Supabase Postgres database in production.
# Find these under Supabase → Project Settings → API / Database.
# SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
# SUPABASE_SERVICE_ROLE_KEY="YOUR_SERVICE_ROLE_KEY"
# SUPABASE_ANON_KEY="YOUR_ANON_KEY"
# SUPABASE_SCHEMA="public"

# ─── CLOUD SYNC GATE ─────────────────────────────────────────────────────────
# Both values must match and be a long random string (e.g. `openssl rand -hex 32`).
# The server rejects /api/sync requests that don't carry the secret header;
# the client value is baked into the production bundle at build time.
# SYNC_DEVICE_SECRET=""
# VITE_SYNC_DEVICE_SECRET=""

# PORT: Server port (defaults to 3000).
# PORT="3000"

# APP_URL: The URL where this app is hosted. Used for self-referential links,
# OAuth callbacks, and API endpoints.
# APP_URL="http://localhost:3000"

# ─── Live AI Calling (Twilio Voice) ──────────────────────────────────────────
# Amani places REAL outbound calls through the Twilio Voice API when these are set.
# Without them the AI Sales Agent runs its full call experience in simulation mode.

# Twilio credentials from the Twilio Console (Account > API Keys & Credentials).
TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_AUTH_TOKEN="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Your Twilio phone number in E.164 format (must have Voice enabled).
TWILIO_PHONE_NUMBER="+12025550123"

# Public HTTPS base URL that Twilio can reach to fetch the call script (TwiML).
# - Development: a tunnel, e.g. "https://abcd1234.ngrok-free.app"
# - Production: your deployed app URL, e.g. "https://your-app.onrender.com"
# Inbound calls: point your Twilio number's "A call comes in" webhook at:
#   <TWILIO_TWIML_BASE_URL>/api/twilio/inbound
TWILIO_TWIML_BASE_URL="https://your-tunnel-url"

# Set to "true" to record every live call (recordings appear in the Twilio console).
TWILIO_RECORD_CALLS="false"

# ─── PAYMENTS (Flutterwave) ──────────────────────────────────────────────────
# Subscriptions, checkout and payouts run in LOCAL SIMULATION MODE until
# FLUTTERWAVE_SECRET_KEY is set — no API keys needed to develop, and every
# flow (pay, decline, poll, withdraw) is fully testable without a card.
#
# Production (live mode):
#   * Put both values below in Render's dashboard → Environment.
#   * Both are SECRET — never commit them, never expose them to the browser
#     (the client only ever talks to /api/payments/* on your own server).
#   * FLUTTERWAVE_SECRET_KEY: secret key from your Flutterwave dashboard
#     (https://dashboard.flutterwave.com → Settings → API).
#   * FLUTTERWAVE_SECRET_HASH: any random string (e.g. `openssl rand -hex 16`).
#     Your server compares it against the "verif-hash" header Flutterwave sends
#     on every webhook. Set the SAME value in your Flutterwave dashboard under
#     Settings → Webhooks → Webhook Hash, so only genuine webhooks are trusted.
#   * Point the dashboard's webhook URL at:
#       https://YOUR-APP-URL/api/payments/webhook
#   * Use a LIVE public HTTPS URL (the Flutterwave payment page requires it —
#     the webhook/callback URLs derive from your APP_URL).
# FLUTTERWAVE_SECRET_KEY=""
# FLUTTERWAVE_SECRET_HASH=""

